generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  avatarKey           String?
  mixedSideOverride   String?
  selfNameChangedAt   DateTime?
  selfGenderChangedAt DateTime?
  gender              String    @default("UNSPECIFIED")
  isActive            Boolean   @default(true)
  sessionVersion      Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  players                       Player[]
  clubAccess                    ClubAccess[]
  rosterOwnership               ClubMember[]                 @relation("RosterOwner")
  clubAdmissionRequests         ClubAdmissionRequest[]       @relation("AdmissionRequester")
  reviewedClubAdmissions        ClubAdmissionRequest[]       @relation("AdmissionReviewer")
  clubAdmissionEvents           ClubAdmissionEvent[]
  createdClubs                  Club[]                       @relation("ClubCreator")
  requestedSessionClubs         SessionClub[]                @relation("SessionClubRequester")
  reviewedSessionClubs          SessionClub[]                @relation("SessionClubReviewer")
  submittedMatchScores          Match[]                      @relation("ScoreSubmitterAccount")
  claimRequestsMade             ClaimRequest[]               @relation("ClaimRequester")
  reviewedClaimRequests         ClaimRequest[]               @relation("ClaimReviewer")
  createdOfflineIdentities      OfflineIdentity[]            @relation("OfflineIdentityCreator")
  resolvedOfflineIdentities     OfflineIdentity[]            @relation("OfflineIdentityResolver")
  requestedOfflineIdentityLinks OfflineIdentityLinkRequest[] @relation("OfflineIdentityLinkRequester")
  reviewedOfflineIdentityLinks  OfflineIdentityLinkRequest[] @relation("OfflineIdentityLinkReviewer")
  passwordResetTokens           PasswordResetToken[]
  tutorialProgress              TutorialProgress[]
  clubNewsLikes                 ClubNewsLike[]
  clubNotificationsActed        ClubNotification[]           @relation("ClubNotificationActor")
  clubRatingAdjustments         ClubRatingAdjustment[]       @relation("ClubRatingAdjustmentActor")
  createdPlayerInvitations      PlayerInvitation[]           @relation("PlayerInvitationCreator")
  redeemedPlayerInvitations     PlayerInvitation[]           @relation("PlayerInvitationRedeemer")
  revokedPlayerInvitations      PlayerInvitation[]           @relation("PlayerInvitationRevoker")
  playerInvitationEvents        PlayerInvitationEvent[]
  authorizedAdmissionEvents     ClubAdmissionEvent[]         @relation("AdmissionEventAuthorizer")
  invitationRecipients          PlayerInvitation[]           @relation("PlayerInvitationRecipient")
  ownershipReleasesReceived     PlayerOwnershipRelease[]     @relation("ReleasedOwner")
  ownershipReleasesAuthorized   PlayerOwnershipRelease[]     @relation("ReleaseAuthorizer")
  ownershipReleaseClaims        PlayerOwnershipReleaseClaim[]
  sessionParticipations         SessionPlayer[]              @relation("SessionParticipantAccount")
  localOwnershipActions         ClubPlayerOwnershipEvent[]   @relation("LocalOwnershipActor")
  localOwnershipPrevious        ClubPlayerOwnershipEvent[]   @relation("LocalOwnershipPrevious")
  localOwnershipNew             ClubPlayerOwnershipEvent[]   @relation("LocalOwnershipNew")

  @@map("Account")
}

model Player {
  lineupTeam1Player1 SessionLineupRow[] @relation("LineupTeam1Player1")
  lineupTeam1Player2 SessionLineupRow[] @relation("LineupTeam1Player2")
  lineupTeam2Player1 SessionLineupRow[] @relation("LineupTeam2Player1")
  lineupTeam2Player2 SessionLineupRow[] @relation("LineupTeam2Player2")

  id                  String    @id @default(cuid())
  ownerUserId         String?
  // Retained for migration provenance only. Authentication reads Account.
  legacyEmail         String?   @unique @map("email") @ignore
  legacyPasswordHash  String?   @map("passwordHash") @ignore
  name                String
  avatarKey           String?
  selfNameChangedAt   DateTime?
  selfGenderChangedAt DateTime?
  legacyIsClaimed     Boolean   @default(false) @map("isClaimed") @ignore
  gender              String    @default("UNSPECIFIED") // MALE, FEMALE, UNSPECIFIED
  partnerPreference   String    @default("OPEN") // legacy MIXICANO preference fallback: OPEN, FEMALE_FLEX
  mixedSideOverride   String? // UPPER, LOWER
  elo                 Int       @default(1000)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessionPlayers               SessionPlayer[]
  clubMemberships              ClubMember[]
  ownerUser                    User?                        @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  creditedHostSessionClubs     SessionClub[]                @relation("SessionClubHostPlayer")
  submittedMatchScores         Match[]                      @relation("ScoreSubmitterPlayer")
  matchEloAdjustments          MatchEloAdjustment[]
  claimRequestsTargeted        ClaimRequest[]               @relation("ClaimTarget")
  offlineIdentityMembers       OfflineIdentityMember[]
  offlineIdentityLinksAsSource OfflineIdentityLinkRequest[] @relation("OfflineIdentityLinkSourcePlayer")
  offlineIdentityLinksAsTarget OfflineIdentityLinkRequest[] @relation("OfflineIdentityLinkTargetPlayer")
  requestedClubAdmissions      ClubAdmissionRequest[]       @relation("AdmissionRequestedPlayer")
  approvedClubAdmissions       ClubAdmissionRequest[]       @relation("AdmissionApprovedPlayer")
  clubNotificationsReceived    ClubNotification[]           @relation("ClubNotificationRecipient")
  invitations                  PlayerInvitation[]
  sourceInvitations            PlayerInvitation[]           @relation("PlayerInvitationSource")
  ownershipReleases            PlayerOwnershipRelease[]
  localOwnershipEvents         ClubPlayerOwnershipEvent[]

  // Match relations (team memberships)
  matchesAsTeam1Player1 Match[] @relation("Team1Player1")
  matchesAsTeam1Player2 Match[] @relation("Team1Player2")
  matchesAsTeam2Player1 Match[] @relation("Team2Player1")
  matchesAsTeam2Player2 Match[] @relation("Team2Player2")

  @@index([ownerUserId])
  @@map("User")
}

model Club {
  allowJoinRequests   Boolean                @default(false)
  joinRequests        ClubAdmissionRequest[]
  id                  String                 @id @default(cuid())
  name                String                 @unique
  rules               String                 @default("")
  avatarKey           String?
  isPasswordProtected Boolean                @default(false)
  passwordHash        String?
  createdById         String
  isTutorial          Boolean                @default(false)
  tutorialOwnerId     String?                @unique
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  createdBy                       User                         @relation("ClubCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members                         ClubMember[]
  accountAccess                   ClubAccess[]
  sessions                        Session[]
  sessionClubs                    SessionClub[]
  matchEloAdjustments             MatchEloAdjustment[]
  claimRequests                   ClaimRequest[]
  offlineIdentityMembers          OfflineIdentityMember[]
  offlineIdentityLinkRequestsFrom OfflineIdentityLinkRequest[] @relation("OfflineIdentityLinkSourceClub")
  offlineIdentityLinkRequestsTo   OfflineIdentityLinkRequest[] @relation("OfflineIdentityLinkTargetClub")
  newsLikes                       ClubNewsLike[]
  notifications                   ClubNotification[]
  playerInvitations               PlayerInvitation[]
  ownershipReleases               PlayerOwnershipRelease[]
  participantProfiles             SessionPlayer[]
  localOwnershipEvents            ClubPlayerOwnershipEvent[]

  @@index([isTutorial])
  @@map("Community")
}

model ClubRatingAdjustment {
  id        String     @id @default(cuid())
  memberId  String
  actorId   String
  actorName String
  beforeElo Int
  afterElo  Int
  reason    String
  createdAt DateTime   @default(now())
  member    ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor     User       @relation("ClubRatingAdjustmentActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([memberId, createdAt])
}

model ClubMember {
  achievementPreferencesJson String                 @default("{}")
  ratingAdjustments          ClubRatingAdjustment[]
  id                         String                 @id @default(cuid())
  clubId                     String                 @map("communityId")
  playerId                   String                 @map("userId")
  ownerUserId                String?
  ownershipRevision          Int                    @default(0)
  legacyRole                 String                 @default("MEMBER") @map("role") @ignore
  status                     String                 @default("CORE") // CORE or OCCASIONAL
  preferredPool              String                 @default("B") // A = Competitive, B = Social
  mixedSideOverride          String?                // Club-specific UPPER/LOWER; null uses gender default
  needsMoreRest              Boolean                @default(false)
  elo                        Int                    @default(1000)
  createdAt                  DateTime               @default(now())
  archivedAt                 DateTime?
  retiredByAdmissionEventId  String?                @unique

  club              Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player            Player              @relation(fields: [playerId], references: [id], onDelete: Restrict)
  ownerUser         User?               @relation("RosterOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  invitations       PlayerInvitation[]
  sourceInvitations PlayerInvitation[]  @relation("PlayerInvitationSourceMember")
  retirementEvent   ClubAdmissionEvent? @relation(fields: [retiredByAdmissionEventId], references: [id], onDelete: Restrict)
  ownershipEvents   ClubPlayerOwnershipEvent[]

  @@unique([clubId, playerId])
  // A migration-owned partial unique index excludes only audited retired rosters.
  @@map("CommunityMember")
}

model ClubAccess {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, STAFF, MEMBER
  status    String   @default("ACTIVE") // ACTIVE, REVOKED
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  ownershipReleases PlayerOwnershipRelease[]
  localOwnershipEvents ClubPlayerOwnershipEvent[]

  @@unique([clubId, userId])
  @@index([userId, status])
}

model Session {
  achievementEligibilityJson String    @default("{}")
  id                         String    @id @default(cuid())
  code                       String    @unique
  clubId                     String?   @map("communityId")
  name                       String
  type                       String    @default("POINTS") // POINTS or ELO
  mode                       String    @default("MEXICANO") // MEXICANO or MIXICANO
  collabFormat               String    @default("FREE_PLAY") // FREE_PLAY or INTERCLUB
  collaborationVersion       Int       @default(1)
  schedulingMode             String    @default("FREE_PLAY") // FREE_PLAY or LINEUP
  scoringFormat              String    @default("SINGLE_GAME") // SINGLE_GAME or BEST_OF_THREE
  ratingMode                 String    @default("RATED") // RATED or UNRATED
  rulesRevision              Int       @default(0)
  resultsRevision            Int       @default(0)
  scoringType                String    @default("POINTS")
  matchmakingStyle           String    @default("BALANCED")
  balanceMetric              String    @default("SESSION_POINTS")
  pairingMode                String    @default("OPEN")
  status                     String    @default("WAITING") // WAITING, ACTIVE, COMPLETED
  ratingPolicyVersion        Int       @default(1)
  isTest                     Boolean   @default(false)
  sourceSessionId            String?
  autoQueueEnabled           Boolean   @default(true)
  respectPlayerRest          Boolean   @default(true)
  poolsEnabled               Boolean   @default(false)
  poolAssignmentsInitialized Boolean   @default(false)
  poolAName                  String?
  poolBName                  String?
  poolACourtAssignments      Int       @default(0)
  poolBCourtAssignments      Int       @default(0)
  poolAMissedTurns           Int       @default(0)
  poolBMissedTurns           Int       @default(0)
  crossoverMissThreshold     Int       @default(1)
  crossoverFrequency         String    @default("BALANCED")
  createdAt                  DateTime  @default(now())
  endedAt                    DateTime?

  club          Club?              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sessionClubs  SessionClub[]
  players       SessionPlayer[]
  courts        Court[]
  matches       Match[]
  queuedMatch   QueuedMatch?
  newsLikes     ClubNewsLike[]
  notifications ClubNotification[]
  lineupRows SessionLineupRow[]
  collaborationEvents SessionCollaborationEvent[]
}

model SessionClub {
  id                   String    @id @default(cuid())
  sessionId            String
  clubId               String    @map("communityId")
  role                 String    @default("PARTNER") // HOST or PARTNER
  status               String    @default("PENDING") // PENDING, ACCEPTED, or REJECTED
  requestedById        String?
  reviewedById         String?
  rulesConfirmedRevision Int?
  resetConfirmedRevision Int?
  creditedHostPlayerId String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  session            Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  club               Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requestedBy        User?   @relation("SessionClubRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy         User?   @relation("SessionClubReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  creditedHostPlayer Player? @relation("SessionClubHostPlayer", fields: [creditedHostPlayerId], references: [id], onDelete: Restrict)

  @@unique([sessionId, clubId])
  @@index([clubId, status])
  @@index([sessionId, role])
  @@map("SessionCommunity")
}

model Court {
  id             String  @id @default(cuid())
  sessionId      String
  courtNumber    Int // 1, 2, or 3
  label          String?
  currentMatchId String? @unique

  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  currentMatch Match?  @relation("CourtCurrentMatch", fields: [currentMatchId], references: [id])
  matches      Match[]
  lineupRows SessionLineupRow[]
}

model SessionPlayer {
  hasStartedMatch Boolean @default(false)
  id                  String  @id @default(cuid())
  sessionId           String
  playerId            String  @map("userId")
  representingClubId  String?
  profileClubId       String?
  participantAccountId String?
  isGuest             Boolean @default(false)
  gender              String  @default("UNSPECIFIED") // MALE, FEMALE, UNSPECIFIED
  partnerPreference   String  @default("OPEN") // legacy MIXICANO preference fallback: OPEN, FEMALE_FLEX
  mixedSideOverride   String? // UPPER, LOWER
  pool                String  @default("A") // A, B
  pendingPool         String? // deferred A/B change while playing or manually queued
  needsMoreRest       Boolean @default(false)
  sessionPoints       Int     @default(0)
  lastPartnerPlayerId String? @map("lastPartnerId") // Raw historical ID; dangling legacy values are retained.
  isPaused            Boolean @default(false)

  // Persisted matchmaking state
  matchesPlayed              Int       @default(0)
  matchmakingMatchesCredit   Int       @default(0)
  availableSince             DateTime  @default(now())
  lastPlayedAt               DateTime?
  pausedAt                   DateTime?
  joinedAt                   DateTime  @default(now())
  ladderEntryAt              DateTime  @default(now())
  arrivalPriorityAt          DateTime?
  skipNextMatchAt            DateTime?
  skipNextMatchRequestedById String?
  inactiveSeconds            Int       @default(0)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Restrict)
  profileClub Club? @relation(fields: [profileClubId], references: [id], onDelete: Restrict)
  participantAccount User? @relation("SessionParticipantAccount", fields: [participantAccountId], references: [id], onDelete: Restrict)

  @@unique([sessionId, playerId])
  @@unique([sessionId, participantAccountId])
  @@index([profileClubId, playerId])
  @@index([sessionId, representingClubId])
}

model Match {
  scoringFormat String @default("SINGLE_GAME")
  gameScoresJson String?
  scoreRevision Int @default(0)
  lineupRow SessionLineupRow?
  id                       String  @id @default(cuid())
  sessionId                String
  courtId                  String
  status                   String  @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, PENDING_APPROVAL
  scoreSubmittedByUserId   String?
  scoreSubmittedByPlayerId String?

  // Team 1
  team1Player1Id String  @map("team1User1Id")
  team1Player2Id String  @map("team1User2Id")
  team1ClubId    String?
  team1Score     Int?

  // Team 2
  team2Player1Id String  @map("team2User1Id")
  team2Player2Id String  @map("team2User2Id")
  team2ClubId    String?
  team2Score     Int?

  winnerTeam            Int? // 1 or 2
  team1EloChange        Int?
  team2EloChange        Int?
  courtGroupType        String? // COMPETITIVE, SOCIAL, CROSSOVER, OPEN_OVERFLOW
  poolASeatCount        Int?
  poolBSeatCount        Int?
  matchmakingReasonJson String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  session                Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  court                  Court                @relation(fields: [courtId], references: [id], onDelete: Cascade)
  courtAsCurrentMatch    Court?               @relation("CourtCurrentMatch")
  eloAdjustments         MatchEloAdjustment[]
  team1Player1           Player               @relation("Team1Player1", fields: [team1Player1Id], references: [id], onDelete: Restrict)
  team1Player2           Player               @relation("Team1Player2", fields: [team1Player2Id], references: [id], onDelete: Restrict)
  team2Player1           Player               @relation("Team2Player1", fields: [team2Player1Id], references: [id], onDelete: Restrict)
  team2Player2           Player               @relation("Team2Player2", fields: [team2Player2Id], references: [id], onDelete: Restrict)
  scoreSubmittedByUser   User?                @relation("ScoreSubmitterAccount", fields: [scoreSubmittedByUserId], references: [id], onDelete: Restrict)
  scoreSubmittedByPlayer Player?              @relation("ScoreSubmitterPlayer", fields: [scoreSubmittedByPlayerId], references: [id], onDelete: Restrict)

  @@index([sessionId, team1ClubId])
  @@index([sessionId, team2ClubId])
}

model SessionLineupRow {
  id String @id @default(cuid())
  sessionId String
  position Int
  revision Int @default(0)
  team1Player1Id String?
  team1Player2Id String?
  team2Player1Id String?
  team2Player2Id String?
  hostConfirmedRevision Int?
  partnerConfirmedRevision Int?
  courtPreferenceId String?
  cancelled Boolean @default(false)
  matchId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  match Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  courtPreference Court? @relation(fields: [courtPreferenceId], references: [id], onDelete: SetNull)
  team1Player1 Player? @relation("LineupTeam1Player1", fields: [team1Player1Id], references: [id], onDelete: Restrict)
  team1Player2 Player? @relation("LineupTeam1Player2", fields: [team1Player2Id], references: [id], onDelete: Restrict)
  team2Player1 Player? @relation("LineupTeam2Player1", fields: [team2Player1Id], references: [id], onDelete: Restrict)
  team2Player2 Player? @relation("LineupTeam2Player2", fields: [team2Player2Id], references: [id], onDelete: Restrict)
  @@index([sessionId, position])
}

model SessionCollaborationEvent {
  id String @id @default(cuid())
  sessionId String
  actorUserId String
  action String
  detailsJson String
  createdAt DateTime @default(now())
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

model MatchEloAdjustment {
  id        String   @id @default(cuid())
  matchId   String
  clubId    String   @map("communityId")
  playerId  String   @map("userId")
  delta     Int
  beforeElo Int
  afterElo  Int
  createdAt DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([matchId, clubId, playerId])
  @@index([clubId, playerId])
  @@index([playerId])
}

model QueuedMatch {
  id                    String   @id @default(cuid())
  sessionId             String   @unique
  team1Player1Id        String   @map("team1User1Id")
  team1Player2Id        String   @map("team1User2Id")
  team1ClubId           String?
  team2Player1Id        String   @map("team2User1Id")
  team2Player2Id        String   @map("team2User2Id")
  team2ClubId           String?
  targetPool            String? // A, B
  courtGroupType        String? // COMPETITIVE, SOCIAL, CROSSOVER, OPEN_OVERFLOW
  poolASeatCount        Int?
  poolBSeatCount        Int?
  isAutomatic           Boolean  @default(false)
  matchmakingReasonJson String?
  createdAt             DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ClaimRequest {
  id              String    @id @default(cuid())
  clubId          String    @map("communityId")
  requesterUserId String
  targetPlayerId  String    @map("targetUserId")
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  note            String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  club       Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requester  User   @relation("ClaimRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  target     Player @relation("ClaimTarget", fields: [targetPlayerId], references: [id], onDelete: Restrict)
  reviewedBy User?  @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([requesterUserId, status])
  @@index([targetPlayerId, status])
}

model OfflineIdentity {
  id             String    @id @default(cuid())
  createdById    String?
  resolvedUserId String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy    User?                        @relation("OfflineIdentityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedUser User?                        @relation("OfflineIdentityResolver", fields: [resolvedUserId], references: [id], onDelete: SetNull)
  members      OfflineIdentityMember[]
  linkRequests OfflineIdentityLinkRequest[]
}

model OfflineIdentityMember {
  id                String   @id @default(cuid())
  offlineIdentityId String
  clubId            String   @map("communityId")
  playerId          String   @map("userId")
  addedById         String?
  createdAt         DateTime @default(now())

  offlineIdentity OfflineIdentity @relation(fields: [offlineIdentityId], references: [id], onDelete: Cascade)
  club            Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player          Player          @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([offlineIdentityId, clubId])
  @@unique([clubId, playerId])
  @@unique([playerId])
  @@index([clubId])
}

model OfflineIdentityLinkRequest {
  id                String    @id @default(cuid())
  offlineIdentityId String?
  sourceClubId      String    @map("sourceCommunityId")
  sourcePlayerId    String    @map("sourceUserId")
  targetClubId      String    @map("targetCommunityId")
  targetPlayerId    String    @map("targetUserId")
  status            String    @default("PENDING") // PENDING, ACCEPTED, or REJECTED
  requestedById     String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  offlineIdentity OfflineIdentity? @relation(fields: [offlineIdentityId], references: [id], onDelete: SetNull)
  sourceClub      Club             @relation("OfflineIdentityLinkSourceClub", fields: [sourceClubId], references: [id], onDelete: Cascade)
  targetClub      Club             @relation("OfflineIdentityLinkTargetClub", fields: [targetClubId], references: [id], onDelete: Cascade)
  sourcePlayer    Player           @relation("OfflineIdentityLinkSourcePlayer", fields: [sourcePlayerId], references: [id], onDelete: Restrict)
  targetPlayer    Player           @relation("OfflineIdentityLinkTargetPlayer", fields: [targetPlayerId], references: [id], onDelete: Restrict)
  requestedBy     User?            @relation("OfflineIdentityLinkRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy      User?            @relation("OfflineIdentityLinkReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([sourceClubId, sourcePlayerId, targetClubId, targetPlayerId])
  @@index([sourceClubId, status])
  @@index([targetClubId, status])
  @@index([offlineIdentityId])
}

model RateLimitBucket {
  key       String   @id
  scope     String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([resetAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TutorialProgress {
  id                   String    @id @default(cuid())
  userId               String
  tutorialKey          String
  completedStepIdsJson String    @default("[]")
  dismissedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tutorialKey])
  @@index([tutorialKey])
}

model ClubNewsLike {
  id         String   @id @default(cuid())
  clubId     String   @map("communityId")
  sessionId  String
  newsItemId String
  userId     String
  createdAt  DateTime @default(now())

  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsItemId, userId])
  @@index([clubId, sessionId])
  @@index([userId])
}

model ClubNotification {
  id                String    @id @default(cuid())
  clubId            String    @map("communityId")
  sessionId         String
  recipientPlayerId String    @map("recipientUserId")
  actorUserId       String
  type              String
  newsItemId        String
  newsType          String
  title             String
  detail            String
  value             String
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  club            Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  session         Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recipientPlayer Player  @relation("ClubNotificationRecipient", fields: [recipientPlayerId], references: [id], onDelete: Restrict)
  actor           User    @relation("ClubNotificationActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([type, newsItemId, actorUserId, recipientPlayerId])
  @@index([clubId, recipientPlayerId, readAt, createdAt])
  @@index([recipientPlayerId, createdAt])
}

model ClubAdmissionRequest {
  id                   String               @id @default(cuid())
  clubId               String
  requesterUserId      String               @map("userId")
  kind                 String               @default("NEW_PLAYER") // EXISTING_PLAYER, NEW_PLAYER, OWNED_PLAYER
  status               String               @default("PENDING")
  requestedPlayerId    String?
  approvedPlayerId     String?
  proposedPlayerName   String?
  proposedGender       String?
  note                 String?
  decision             String?
  revision             Int                  @default(0)
  legacyClaimRequestId String?              @unique
  idempotencyKey       String?
  originInvitationId   String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  reviewedAt           DateTime?
  reviewedByUserId     String?              @map("reviewedById")
  club                 Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requester            User                 @relation("AdmissionRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  requestedPlayer      Player?              @relation("AdmissionRequestedPlayer", fields: [requestedPlayerId], references: [id], onDelete: Restrict)
  approvedPlayer       Player?              @relation("AdmissionApprovedPlayer", fields: [approvedPlayerId], references: [id], onDelete: Restrict)
  reviewedBy           User?                @relation("AdmissionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  events               ClubAdmissionEvent[]
  localOwnershipEvents ClubPlayerOwnershipEvent[]
  originInvitation     PlayerInvitation?    @relation(fields: [originInvitationId], references: [id], onDelete: Restrict)

  @@unique([requesterUserId, idempotencyKey])
  @@index([clubId, status])
  @@index([originInvitationId, requesterUserId])
  @@map("ClubJoinRequest")
}

model ClubAdmissionEvent {
  id                 String               @id @default(cuid())
  admissionRequestId String
  actorUserId        String?
  authorizedByUserId String?
  action             String
  revision           Int
  detailsJson        String               @default("{}")
  createdAt          DateTime             @default(now())
  admissionRequest   ClubAdmissionRequest @relation(fields: [admissionRequestId], references: [id], onDelete: Restrict)
  actor              User?                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  authorizedBy       User?                @relation("AdmissionEventAuthorizer", fields: [authorizedByUserId], references: [id], onDelete: Restrict)
  retiredMember      ClubMember?

  @@unique([admissionRequestId, revision])
}

model PlayerInvitation {
  id                       String    @id @default(cuid())
  clubId                   String
  playerId                 String
  clubMemberId             String
  targetOwnershipRevision  Int       @default(0)
  createdByUserId          String
  purpose                  String    @default("CLAIM") // CLAIM, CORRECTION, ACCESS_RESTORE
  targetAccountUserId      String?
  sourcePlayerId           String?
  sourceMemberId           String?
  retireSourcePlayerId     String?
  authorizedAccessAction   String? // PRESERVE_ACTIVE, GRANT_MEMBER, RESTORE_MEMBER
  restoreArchivedRoster    Boolean   @default(false)
  authorizationReason      String?
  authorizerAccessId       String?
  authorizerAccessRevision Int?
  recipientAccessId        String?
  recipientAccessStatus    String?
  recipientAccessRole      String?
  recipientAccessRevision  Int?
  tokenHash                String    @unique
  status                   String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, REDEEMED
  expiresAt                DateTime
  redeemedByUserId         String?
  redeemedAt               DateTime?
  revokedByUserId          String?
  revokedAt                DateTime?
  revocationReason         String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  club             Club                           @relation(fields: [clubId], references: [id], onDelete: Restrict)
  player           Player                         @relation(fields: [playerId], references: [id], onDelete: Restrict)
  clubMember       ClubMember                     @relation(fields: [clubMemberId], references: [id], onDelete: Restrict)
  createdByUser    User                           @relation("PlayerInvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  targetAccount    User?                          @relation("PlayerInvitationRecipient", fields: [targetAccountUserId], references: [id], onDelete: Restrict)
  sourcePlayer     Player?                        @relation("PlayerInvitationSource", fields: [sourcePlayerId], references: [id], onDelete: Restrict)
  sourceMember     ClubMember?                    @relation("PlayerInvitationSourceMember", fields: [sourceMemberId], references: [id], onDelete: Restrict)
  redeemedByUser   User?                          @relation("PlayerInvitationRedeemer", fields: [redeemedByUserId], references: [id], onDelete: Restrict)
  revokedByUser    User?                          @relation("PlayerInvitationRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  events           PlayerInvitationEvent[]
  localOwnershipEvent ClubPlayerOwnershipEvent?
  continuations    PlayerInvitationContinuation[]
  recoveryRequests ClubAdmissionRequest[]
  ownershipReleaseClaim PlayerOwnershipReleaseClaim?

  @@index([clubId, playerId, status])
  @@index([expiresAt])
  @@index([purpose, status])
  @@index([sourcePlayerId, status])
  @@index([targetAccountUserId, status])
}

// Immutable audit; its insert trigger applies the explicit, scoped owner release.
model PlayerOwnershipRelease {
  id                  String   @id
  clubId              String
  playerId            String
  previousOwnerUserId String
  actorUserId         String
  accessId            String
  accessRevision      Int
  membershipsJson     String
  reason              String
  createdAt           DateTime
  appliedAt           DateTime?

  club          Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  previousOwner User        @relation("ReleasedOwner", fields: [previousOwnerUserId], references: [id], onDelete: Restrict)
  authorizer    User        @relation("ReleaseAuthorizer", fields: [actorUserId], references: [id], onDelete: Restrict)
  access        ClubAccess  @relation(fields: [accessId], references: [id], onDelete: Restrict)
  claim         PlayerOwnershipReleaseClaim?
}
model PlayerOwnershipReleaseClaim {
  releaseId    String   @id
  invitationId String   @unique
  actorUserId  String
  createdAt    DateTime

  release    PlayerOwnershipRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  invitation PlayerInvitation       @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  actor      User                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
}
model PlayerInvitationEvent {
  id           String           @id @default(cuid())
  invitationId String
  actorUserId  String?
  action       String
  reason       String?
  detailsJson  String           @default("{}")
  createdAt    DateTime         @default(now())
  invitation   PlayerInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  actor        User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([invitationId, createdAt])
}

// A hashed, short-lived browser capability, separate from the seven-day invite secret.
model PlayerInvitationContinuation {
  id           String           @id @default(cuid())
  invitationId String
  handleHash   String           @unique
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  invitation   PlayerInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, expiresAt])
}

// An append-only local transition receipt. SQLite validates and applies the
// exact ownership/access revisions in the same statement as insertion.
model ClubPlayerOwnershipEvent {
  id                        String   @id @default(cuid())
  clubId                    String
  clubMemberId              String
  playerId                  String
  actorUserId               String
  action                    String // CLAIM, REMOVE, DISCONNECT, LEAVE, ARCHIVE
  previousOwnerUserId       String?
  newOwnerUserId            String?
  previousOwnershipRevision Int
  newOwnershipRevision      Int
  accessId                  String?
  previousAccessRevision    Int?
  newAccessRevision         Int?
  previousAccessStatus      String?
  newAccessStatus           String?
  previousAccessRole        String?
  newAccessRole             String?
  invitationId              String?  @unique
  admissionRequestId        String?
  releaseEventId            String?  @unique
  metadataBeforeJson        String
  metadataAfterJson         String
  detailsJson               String   @default("{}")
  reason                    String
  createdAt                 DateTime @default(now())
  club                      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  member                    ClubMember @relation(fields: [clubMemberId], references: [id], onDelete: Restrict)
  player                    Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  actor                     User     @relation("LocalOwnershipActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  previousOwner             User?    @relation("LocalOwnershipPrevious", fields: [previousOwnerUserId], references: [id], onDelete: Restrict)
  newOwner                  User?    @relation("LocalOwnershipNew", fields: [newOwnerUserId], references: [id], onDelete: Restrict)
  access                    ClubAccess? @relation(fields: [accessId], references: [id], onDelete: Restrict)
  invitation                PlayerInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  admissionRequest          ClubAdmissionRequest? @relation(fields: [admissionRequestId], references: [id], onDelete: Restrict)
  releaseEvent              ClubPlayerOwnershipEvent? @relation("LocalReleaseUse", fields: [releaseEventId], references: [id], onDelete: Restrict)
  usedBy                    ClubPlayerOwnershipEvent? @relation("LocalReleaseUse")

  @@unique([clubMemberId, newOwnershipRevision])
  @@index([clubId, playerId, createdAt])
  @@index([previousOwnerUserId, clubId])
}
